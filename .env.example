# Copy to .env on each machine:  ./setup.sh   (or: printf 'UID=%s\nGID=%s\n' $(id -u) $(id -g) > .env)
#
# These are baked into the image as the container user's UID/GID so that files
# written to the bind-mounted workspace/ are owned by you on the host rather
# than by root. They are NOT committed, because the correct values differ per
# machine -- a teammate whose account is 1001 gets root-owned files if they
# inherit a 1000 from git.
#
# Why a file at all, rather than `export UID GID`: docker compose does not read
# exported shell variables reliably for build args across all versions, and UID
# is readonly in bash on some systems, so the export silently no-ops.
UID=1000
GID=1000
