# Interbotix X-Series udev rules -- install on the HOST, not in the container.
#
# Docker cannot create these: udev runs in the host kernel's device manager, and
# a container only ever sees the device nodes the host already made. This is the
# one part of the setup that is per-machine rather than baked into the image.
#
#   sudo cp 99-interbotix-udev.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#
# Verify with the U2D2 plugged in:  ls -l /dev/ttyDXL
#
# Sourced from Interbotix/interbotix_ros_core (humble branch),
# interbotix_ros_xseries/interbotix_xs_sdk/99-interbotix-udev.rules

# Allow serial devices to be read by anyone
KERNEL=="ttyUSB*", MODE:="0666"
KERNEL=="ttyACM*", MODE:="0666"
KERNEL=="js*", MODE:="0666"
KERNEL=="video*", MODE:="0666"

# U2D2 board (also sets latency timer to 1ms for faster communication)
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6014", ENV{ID_MM_DEVICE_IGNORE}="1", ATTR{device/latency_timer}="1", SYMLINK+="ttyDXL"

# OpenCM9.04C board
SUBSYSTEM=="tty", ATTRS{idVendor}=="fff1", ATTRS{idProduct}=="ff48", ENV{ID_MM_DEVICE_IGNORE}="1", SYMLINK+="ttyDXL"

# ---------------------------------------------------------------------------
# Multiple U2D2s on one host
#
# The rule above gives EVERY U2D2 the same /dev/ttyDXL symlink, so with more
# than one attached the name races and binds to whichever enumerated last.
# That is fine for this machine today (the two manipulator arms are WXAI over
# Ethernet, so the middle arm is the only U2D2), but it breaks the moment a
# second one is plugged in.
#
# Fix by keying on each adapter's FTDI serial -- the same scheme AV-ALOHA used
# with /dev/ttyDXL_puppet_middle. Read the serial with:
#
#   udevadm info --name=/dev/ttyUSB0 --attribute-walk | grep '{serial}' | head -1
#
# then uncomment and fill in:
#
# SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6014", ATTRS{serial}=="FT XXXXXXX", ENV{ID_MM_DEVICE_IGNORE}="1", ATTR{device/latency_timer}="1", SYMLINK+="ttyDXL_middle"
#
# and set DXL_PORT=/dev/ttyDXL_middle in docker-compose.yml.
