# Machine-specific: UID/GID differ per host, so this is generated rather than
# committed. See .env.example and the top-level README.
.env

# Python
__pycache__/
*.py[cod]

# colcon build artifacts inside the bind-mounted workspaces. Only src/ and the
# hand-written scripts belong in git -- build/, install/ and log/ are outputs,
# and install/ in particular is full of absolute paths from whichever machine
# produced it, which makes it actively harmful to share.
*/workspace/build/
*/workspace/install/
*/workspace/log/

# Driver logs written into the bind mount. Keeping them out of git but ON the
# host is deliberate: a driver run inside `docker compose exec` dies with its
# terminal and takes its output with it, which is exactly how the first SLATE
# bring-up lost the log of a crash. Redirect to one of these instead.
*.log

# Recorded data. Keep episodes out of the code repo -- they are large, binary,
# and versioning them here will make the repo unusable within a few sessions.
*/workspace/data/
*/workspace/datasets/
*.bag
*.mcap

# Editor / OS noise
.vscode/
.idea/
*.swp
.DS_Store
quest/secrets/*
!quest/secrets/README.md
